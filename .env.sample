# Portfolio assistant (Gemini), SERVER-ONLY.
# Read only by api/chat.ts in Vercel Functions (and by the Vite dev server's
# /api/chat middleware during `npm run dev`). Set it in Vercel > Settings >
# Environment Variables (Production and Preview) and in .env.local for dev.
# Never prefix it with VITE_: VITE_* values ship in the browser bundle.
# Get a key from https://ai.google.dev/gemini-api/docs/api-key and restrict it
# to the Generative Language API.
# GEMINI_API_KEY=
# Optional comma-separated model override (default: gemini-2.5-flash,gemini-2.0-flash)
# CHAT_MODELS=

# Firebase web config for the hidden admin page (Firebase project settings >
# Your apps > Web app). These are public identifiers, not credentials: access
# control lives in firestore.rules. Put real values in .env.local (gitignored)
# and in Vercel > Settings > Environment Variables.
# VITE_* values ship in the browser bundle. Never put service-account JSON,
# Admin SDK keys, CLI tokens, or deploy-hook URLs in any VITE_* variable.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=assistente-virtual-e4322.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=assistente-virtual-e4322
VITE_FIREBASE_APP_ID=your_firebase_web_app_id_here

# Vercel Blob uploads (admin CV, profile photo, project images).
# SERVER-ONLY: read by api/blob-upload.ts in Vercel Functions. Set it in
# Vercel > Settings > Environment Variables (Production and Preview).
# Never prefix it with VITE_, never inject it through `define`, never commit it.
# BLOB_READ_WRITE_TOKEN=

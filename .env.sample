# Gemini API Configuration
# Get your API key from: https://ai.google.dev/gemini-api/docs/api-key
# 
# For local development:
#   1. Copy this file to .env
#   2. Replace the placeholder with your actual API key
#
# For Vercel deployment:
#   1. Go to your Vercel project settings
#   2. Navigate to Settings > Environment Variables
#   3. Add VITE_GEMINI_API_KEY with your API key value
#
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase web config for the hidden admin page (Firebase project settings >
# Your apps > Web app). These are public identifiers, not credentials: access
# control lives in firestore.rules. Put real values in .env.local (gitignored)
# and in Vercel > Settings > Environment Variables.
# VITE_* values ship in the browser bundle. Never put service-account JSON,
# Admin SDK keys, CLI tokens, or deploy-hook URLs in any VITE_* variable.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=assistente-virtual-e4322.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=assistente-virtual-e4322
VITE_FIREBASE_APP_ID=your_firebase_web_app_id_here

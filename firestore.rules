rules_version = '2';

// Firestore Security Rules for the hugoviegas.dev content backend.
// These rules are the access control. The hidden admin URL is obscurity only.
//
// OWNER: the UID below is Hugo's Firebase Auth UID (Firebase console >
// Authentication > Users). It is an identifier, not a secret. Change it only
// together with a rules deploy.
//
// Field limits mirror src/content/schema.ts (LIMITS): change both together.
// Rules cannot check each element of a list, only its size; the admin
// validates list items with Zod before writing.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'pDIVBg1M6najIUMkuW2GLuYpszx1'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Anyone may read a published doc; only the owner may read drafts.
    // isOwner() comes first so the owner can also read missing docs.
    // Public list queries must filter on published == true.
    function isPublishedOrOwner() {
      return isOwner() || resource.data.published == true;
    }

    // ---------------------------------------------------------------- helpers

    function validId(id) {
      return id.matches('^[a-z0-9-]{1,100}$');
    }

    function str(value, max) {
      return value is string && value.size() <= max;
    }

    function filled(value) {
      return value is string && value.trim().size() > 0;
    }

    function strList(value, max) {
      return value is list && value.size() <= max;
    }

    function httpsOrEmpty(value) {
      return str(value, 300) && (value == '' || value.matches('^https://.+'));
    }

    function exactKeys(data, keys) {
      return data.keys().hasOnly(keys) && data.keys().hasAll(keys);
    }

    // A file in the public Vercel Blob store. `path` is a regex for the part
    // after the host. Mirrors src/content/uploadPolicy.ts: change both together.
    function blobUrl(value, path) {
      return str(value, 300)
        && value.matches('^https://sb7cb98htp9acpqo[.]public[.]blob[.]vercel-storage[.]com/' + path + '$');
    }

    // updatedAt is the server time of this write; version goes 1, 2, 3...
    // so a stale admin tab cannot overwrite a newer edit.
    function validMeta(data) {
      return data.published is bool
        && data.order is int && data.order >= 0 && data.order <= 10000
        && data.updatedAt == request.time
        && data.version is int
        && (request.method == 'create'
          ? data.version == 1
          : data.version == resource.data.version + 1);
    }

    function contentKeys(extra) {
      return ['published', 'order', 'updatedAt', 'version', 'en', 'ptBR'].concat(extra);
    }

    // --------------------------------------------------------- per collection

    function timelineText(t) {
      return t is map
        && exactKeys(t, ['title', 'organization', 'location', 'period', 'description', 'bullets'])
        && str(t.title, 200) && str(t.organization, 200) && str(t.location, 120)
        && str(t.period, 80) && str(t.description, 1000) && strList(t.bullets, 30);
    }

    function timelineFilled(t) {
      return filled(t.title) && filled(t.organization) && filled(t.period);
    }

    function validTimeline(data) {
      return exactKeys(data, contentKeys([])) && validMeta(data)
        && timelineText(data.en) && timelineText(data.ptBR)
        && (data.published == false || (timelineFilled(data.en) && timelineFilled(data.ptBR)));
    }

    function projectText(t) {
      return t is map
        && exactKeys(t, ['title', 'description', 'imageAlt'])
        && str(t.title, 120) && str(t.description, 1000) && str(t.imageAlt, 200);
    }

    function projectFilled(t) {
      return filled(t.title) && filled(t.description) && filled(t.imageAlt);
    }

    // A bundled image key, or an image uploaded for a project.
    function validProjectImage(image) {
      return image == ''
        || (image is string && image.matches('^[a-z0-9-]{1,100}$'))
        || blobUrl(image, 'projects/[a-z0-9-]{1,100}/[A-Za-z0-9-]{1,120}[.](webp|avif|jpg|png)');
    }

    function validProject(data) {
      return exactKeys(data, contentKeys([
          'image', 'imageWidth', 'imageHeight', 'technologies',
          'liveUrl', 'githubUrl', 'detailPath']))
        && validMeta(data)
        && validProjectImage(data.image)
        && data.imageWidth is int && data.imageWidth >= 0 && data.imageWidth <= 10000
        && data.imageHeight is int && data.imageHeight >= 0 && data.imageHeight <= 10000
        && strList(data.technologies, 30)
        && httpsOrEmpty(data.liveUrl) && httpsOrEmpty(data.githubUrl)
        && str(data.detailPath, 120)
        && (data.detailPath == '' || data.detailPath.matches('^/[a-z0-9/-]*$'))
        && projectText(data.en) && projectText(data.ptBR)
        && (data.published == false || (projectFilled(data.en) && projectFilled(data.ptBR)));
    }

    function skillText(t) {
      return t is map && exactKeys(t, ['label']) && str(t.label, 120);
    }

    function validSkill(data) {
      return exactKeys(data, contentKeys(['group', 'iconKey'])) && validMeta(data)
        && data.group in ['programming', 'it', 'certification', 'focus']
        && str(data.iconKey, 40)
        && skillText(data.en) && skillText(data.ptBR)
        && (data.published == false || (filled(data.en.label) && filled(data.ptBR.label)));
    }

    function aboutText(t) {
      return t is map
        && exactKeys(t, ['summary', 'highlights', 'fullStory'])
        && strList(t.summary, 30) && strList(t.highlights, 30) && str(t.fullStory, 20000);
    }

    function aboutFilled(t) {
      return t.summary.size() > 0 && filled(t.fullStory);
    }

    function validAbout(data) {
      return exactKeys(data, contentKeys([])) && validMeta(data)
        && aboutText(data.en) && aboutText(data.ptBR)
        && (data.published == false || (aboutFilled(data.en) && aboutFilled(data.ptBR)));
    }

    function detailText(t) {
      return t is map
        && exactKeys(t, ['title', 'summary', 'sections', 'faq', 'storyTitle', 'storyIntro', 'story'])
        && str(t.title, 120) && str(t.summary, 1000)
        && strList(t.sections, 30) && strList(t.faq, 30)
        && str(t.storyTitle, 120) && str(t.storyIntro, 1000) && str(t.story, 20000);
    }

    function validDetail(data) {
      return exactKeys(data, contentKeys(['stack'])) && validMeta(data)
        && strList(data.stack, 30)
        && detailText(data.en) && detailText(data.ptBR)
        && (data.published == false
          || (filled(data.en.title) && filled(data.en.summary)
            && filled(data.ptBR.title) && filled(data.ptBR.summary)));
    }

    function validCv(file) {
      return file is map
        && exactKeys(file, ['url', 'version'])
        && blobUrl(file.url, 'cv/[A-Za-z0-9-]{1,120}[.]pdf')
        && file.version is int && file.version >= 1;
    }

    function validPhoto(file) {
      return file is map
        && exactKeys(file, ['url', 'width', 'height', 'alt', 'version'])
        && blobUrl(file.url, 'profile/[A-Za-z0-9-]{1,120}[.](webp|avif|jpg|png)')
        && file.width is int && file.width >= 1 && file.width <= 10000
        && file.height is int && file.height >= 1 && file.height <= 10000
        && file.alt is map && exactKeys(file.alt, ['en', 'ptBR'])
        && str(file.alt.en, 200) && filled(file.alt.en)
        && str(file.alt.ptBR, 200) && filled(file.alt.ptBR)
        && file.version is int && file.version >= 1;
    }

    // cv and profilePhoto are optional; when absent the site uses the
    // bundled photo and the current CV link.
    function validSettings(data) {
      return data.keys().hasAll(['useRemote', 'updatedAt', 'version'])
        && data.keys().hasOnly(['useRemote', 'updatedAt', 'version', 'cv', 'profilePhoto'])
        && (!('cv' in data) || validCv(data.cv))
        && (!('profilePhoto' in data) || validPhoto(data.profilePhoto))
        && data.useRemote is bool
        && data.updatedAt == request.time
        && data.version is int
        && (request.method == 'create'
          ? data.version == 1
          : data.version == resource.data.version + 1);
    }

    function validHistory(data) {
      return exactKeys(data, ['collection', 'docId', 'version', 'data', 'savedAt'])
        && data.collection in ['experience', 'education', 'projects', 'projectDetails', 'skills', 'about', 'settings']
        && str(data.docId, 100)
        && data.version is int
        && data.data is map
        && data.savedAt == request.time;
    }

    // ------------------------------------------------------------------ paths

    // Access probe for the admin page. Any account that gets
    // permission-denied here is signed out immediately.
    match /admin/ping {
      allow read: if isOwner();
    }

    match /experience/{docId} {
      allow read: if isPublishedOrOwner();
      allow create, update: if isOwner() && validId(docId) && validTimeline(request.resource.data);
      allow delete: if isOwner();
    }

    match /education/{docId} {
      allow read: if isPublishedOrOwner();
      allow create, update: if isOwner() && validId(docId) && validTimeline(request.resource.data);
      allow delete: if isOwner();
    }

    match /projects/{docId} {
      allow read: if isPublishedOrOwner();
      allow create, update: if isOwner() && validId(docId) && validProject(request.resource.data);
      allow delete: if isOwner();
    }

    match /projectDetails/{docId} {
      allow read: if isPublishedOrOwner();
      allow create, update: if isOwner() && validId(docId) && validDetail(request.resource.data);
      allow delete: if isOwner();
    }

    match /skills/{docId} {
      allow read: if isPublishedOrOwner();
      allow create, update: if isOwner() && validId(docId) && validSkill(request.resource.data);
      allow delete: if isOwner();
    }

    match /about/{docId} {
      allow read: if isPublishedOrOwner();
      allow create, update: if isOwner() && validId(docId) && validAbout(request.resource.data);
      allow delete: if isOwner();
    }

    // Site-wide switches (useRemote kill switch) and the public CV and
    // profile photo URLs. Public: everything here is shown on the site.
    // Every admin save bumps updatedAt so the public refresh notices.
    match /settings/site {
      allow read: if true;
      allow create, update: if isOwner() && validSettings(request.resource.data);
    }

    // Previous versions of edited docs. Owner only, create-only: history is
    // never edited or deleted.
    match /contentHistory/{entryId} {
      allow read: if isOwner();
      allow create: if isOwner() && validHistory(request.resource.data);
    }

    // Everything else is implicitly denied.
  }
}

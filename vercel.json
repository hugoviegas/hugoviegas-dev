{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.hugoviegas.dev" }],
      "destination": "https://hugoviegas.dev/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "hugoviegas.vercel.app" }],
      "destination": "https://hugoviegas.dev/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(formula-d|lightsaber|micro-falcon|starship-demo|404.html)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/games/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/projects/darcy-mcgees", "destination": "/projects/darcy-mcgees.html" },
    { "source": "/projects/big-bang-duel", "destination": "/projects/big-bang-duel.html" },
    { "source": "/projects/big-bang-duel/story", "destination": "/projects/big-bang-duel/story.html" },
    { "source": "/formula-d", "destination": "/index.html" },
    { "source": "/lightsaber", "destination": "/index.html" },
    { "source": "/micro-falcon", "destination": "/index.html" },
    { "source": "/starship-demo", "destination": "/index.html" }
  ]
}
